# 两种模式共用。默认 --via sdk 走 DeepSeek Harness Python SDK，映射成 DEEPSEEK_*。
# 本机 CLI（--via grok|codex|dsh）有则注入，没有则用 CLI 自己的登录。
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://your-gateway.example/v1
LLM_MODELS=gpt-5.4

# GAMEAIHACK_VIA=sdk
# GAMEAIHACK_VIA=grok

# 仅 grok/codex CLI：网关若必须走 /v1/responses
# LLM_API_BACKEND=responses

# 也认 OPENAI_API_KEY / OPENAI_BASE_URL / DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL
# DSH_MODEL=gpt-5.4
