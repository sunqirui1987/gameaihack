# 两种模式共用：自建 agent（默认 --via sdk）必须配；
# 本机 CLI（--via grok|codex）有则注入到子进程，没有则用 CLI 自己的登录。
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://your-gateway.example/v1
LLM_MODELS=gpt-5.4

# 默认 sdk。本机 grok / Codex / DSH：
# GAMEAIHACK_VIA=grok

# 网关协议。默认 chat completions。若 CLI 必须走 /v1/responses：
# LLM_API_BACKEND=responses

# 也认 OPENAI_API_KEY / OPENAI_BASE_URL / DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL
# DSH_MODEL=gpt-5.4
