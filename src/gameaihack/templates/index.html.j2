<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{{ package_name }} · 解剖包</title>
  <style>
    :root { --bg:#0f1419; --card:#1a2330; --fg:#e7ecf3; --mut:#8b9bb4; --acc:#7dd3fc; --bad:#fb7185; --line:#2a3648; }
    * { box-sizing: border-box; }
    body { margin:0; font-family: ui-sans-serif, system-ui, "PingFang SC", "Noto Sans SC", sans-serif; background:var(--bg); color:var(--fg); line-height:1.55; }
    main { max-width: 1100px; margin: 0 auto; padding: 32px 20px 80px; }
    h1 { font-size: 1.6rem; margin: 0 0 8px; }
    h2 { font-size: 1.15rem; margin: 32px 0 12px; color:var(--acc); }
    .mut { color: var(--mut); }
    .banner { background:#3f1d24; border:1px solid var(--bad); color:#fecaca; padding:12px 16px; border-radius:10px; margin:16px 0; }
    .card { background:var(--card); border:1px solid var(--line); border-radius:12px; padding:16px 18px; margin:12px 0; }
    table { width:100%; border-collapse: collapse; font-size: 14px; }
    th, td { text-align:left; padding:8px 10px; border-bottom:1px solid var(--line); vertical-align:top; }
    th { color:var(--mut); font-weight:600; }
    .score { font-variant-numeric: tabular-nums; }
    .bar { height:8px; background:#243044; border-radius:99px; overflow:hidden; min-width:80px; }
    .bar > span { display:block; height:100%; background:linear-gradient(90deg,#38bdf8,#a78bfa); }
    ul { margin:8px 0; padding-left: 18px; }
    a { color: var(--acc); }
    code { font-size: 0.9em; background:#243044; padding:1px 6px; border-radius:4px; }
    nav a { margin-right: 12px; }
    .grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(120px,1fr)); gap:10px; }
    figure { margin:0; background:#121922; border-radius:8px; overflow:hidden; border:1px solid var(--line); }
    figure img { width:100%; height:80px; object-fit:cover; display:block; background:#0b0f14; }
    figcaption { font-size:11px; padding:6px 8px; color:var(--mut); word-break:break-all; }
    input[type=search] { width:100%; padding:8px 10px; border-radius:8px; border:1px solid var(--line); background:#121922; color:var(--fg); }
    .lv { display:inline-block; margin:8px 8px 0 0; }
    .lv img { width:160px; height:auto; border-radius:8px; border:1px solid var(--line); }
  </style>
</head>
<body>
<main>
  <p class="mut">gameaihack {{ tool_version }} · {{ job_id }} · {{ mode }} · 雷达均分 {{ radar_avg }}</p>
  <h1>{{ package_name }}</h1>
  <p>{{ one_liner }}</p>
  <nav class="mut">
    <a href="#radar">雷达</a>
    <a href="#assets">资源</a>
    <a href="#levels">关卡</a>
    <a href="#tables">表</a>
    <a href="#claims">主张</a>
    <a href="COVER.md">封面</a>
    <a href="design/00-雷达与缺口.md">策划</a>
    <a href="machine/game.ir.json">IR</a>
  </nav>
  {% if incomplete %}
  <div class="banner">残缺输入 {{ input_score }}/100 — 覆盖率会偏低。请补 OBB / 热更后再分析。</div>
  {% endif %}
  <div class="card">
    <table>
      <tr><th>引擎</th><td>{{ engine }} / {{ script_backend }} / {{ engine_version }}</td></tr>
      <tr><th>品类</th><td>{{ genre }}</td></tr>
      <tr><th>保护 / 热更</th><td>{{ protection }} / {{ hotupdate }}</td></tr>
      <tr><th>命中规则</th><td>{{ matched_rules }}</td></tr>
      <tr><th>输入分</th><td class="score">{{ input_score }}/100</td></tr>
      <tr><th>规模</th><td>资源 {{ n_res }} · 表 {{ n_tb }} · 关卡 {{ n_lv }} · 主张 {{ n_claim }}</td></tr>
    </table>
  </div>
  <h2 id="radar">完整度雷达</h2>
  <div class="card">
    <table>
      <thead><tr><th>维</th><th>分</th><th></th><th>缺口</th></tr></thead>
      <tbody>
      {% for r in radar %}
        <tr>
          <td>{{ r.label }}</td>
          <td class="score">{{ r.score }}/{{ r.max }}</td>
          <td><div class="bar"><span style="width:{{ (r.score / r.max * 100)|int }}%"></span></div></td>
          <td class="mut">{{ (r.blockers or [])|join(", ") or "—" }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  <h2 id="assets">资源</h2>
  <div class="card">
    <input type="search" id="q" placeholder="过滤资源名 / 类型" oninput="filterRes()"/>
    <p class="mut">完整目录见 <a href="assets/catalog.json">catalog.json</a> · 共 {{ n_res }}</p>
    <div class="grid" id="grid">
      {% for r in resource_cards %}
      <figure data-name="{{ r.name }} {{ r.kind }} {{ r.original_path }}">
        {% if r.thumb %}<img src="{{ r.thumb }}" alt="{{ r.name }}"/>{% endif %}
        <figcaption>{{ r.kind }} · {{ r.name }}</figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
  <h2 id="levels">关卡</h2>
  <div class="card">
    {% if levels %}
      <p class="mut">共 {{ n_lv }} 关{% if n_chapters %} / {{ n_chapters }} 章{% endif %}（多数为 Addressables 索引，无俯视图）。</p>
      {% for lv in levels[:40] %}
      <div class="lv">
        <div><a href="levels/{{ lv.id }}/level.json">{{ lv.id }}</a> · {{ lv.rebuild_grade }} · {{ lv.kind }}</div>
        {% if lv.preview %}
        <img src="levels/{{ lv.id }}/preview.png" alt="{{ lv.id }}"/>
        {% endif %}
      </div>
      {% endfor %}
      <p><a href="levels/gallery.html">关卡画廊</a> · <a href="levels/gallery.md">Markdown</a></p>
    {% else %}
      <p class="mut">未重建关卡。可能在服务端或加密容器里。</p>
    {% endif %}
  </div>
  <h2 id="tables">表</h2>
  <div class="card">
    {% if tables %}
    <table>
      <thead><tr><th>id</th><th>role</th><th>行</th><th>状态</th></tr></thead>
      {% for t in tables %}
      <tr>
        <td><a href="tables/{{ t.id.replace(':', '_') }}.csv">{{ t.id }}</a></td>
        <td>{{ t.role }}</td>
        <td>{{ t.row_count }}</td>
        <td>{{ t.schema_state }}</td>
      </tr>
      {% endfor %}
    </table>
    {% else %}
    <p class="mut">未解码到配置表。</p>
    {% endif %}
  </div>
  <h2 id="claims">策划主张</h2>
  <div class="card">
    {% for c in claims %}
    <p><code>{{ c.id }}</code> · {{ c.severity }}/{{ c.confidence }}<br/>{{ c.text }}
      {% if c.evidence %}<br/><span class="mut">{% for e in c.evidence %}{{ e.path }} · {{ e.extractor }}{% if not loop.last %}； {% endif %}{% endfor %}</span>{% endif %}
    </p>
    {% endfor %}
    {% if not claims %}<p class="mut">无主张</p>{% endif %}
  </div>
  <h2>警告</h2>
  <div class="card">
    {% if warnings %}
    <ul>{% for w in warnings %}<li><code>{{ w }}</code></li>{% endfor %}</ul>
    {% else %}
    <p class="mut">无输入警告</p>
    {% endif %}
  </div>
</main>
<script>
function filterRes(){
  const q = (document.getElementById('q').value || '').toLowerCase();
  document.querySelectorAll('#grid figure').forEach(f => {
    f.style.display = f.dataset.name.toLowerCase().includes(q) ? '' : 'none';
  });
}
</script>
</body>
</html>
